# Omniva Multi-Tenant SaaS Platform Environment Configuration Example
# Copy this file to .env or backend/.env and replace every placeholder.
# Production startup rejects missing, default, or example secrets.

# Server & Application Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://your-app-domain.example
# Set true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/omniva_saas?retryWrites=true&w=majority

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Token Encryption at Rest (AES-256-GCM)
# 32-character string or 64-character hex key. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_a_random_32_character_token_encryption_key

# Required once to create the first Super Admin. Generate with: openssl rand -hex 32
MASTER_SETUP_KEY=replace_with_a_random_64_character_master_setup_key

# Meta Ads Lead Management & Graph API Integration
# Meta Developer Portal -> App Settings -> Basic
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=https://your-app-domain.example/api/meta/oauth/callback
META_GRAPH_API_VERSION=v21.0
# Base URL for all Meta Graph API calls. Only override for Meta's sandbox or for tests.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
# Hard timeout for a single Meta Graph API request (milliseconds).
META_GRAPH_TIMEOUT_MS=10000
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_meta_webhook_verify_token

# Meta Conversions API (CAPI) Fallback
META_ACCESS_TOKEN=your_meta_system_user_capi_token_optional

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# From the Razorpay dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
