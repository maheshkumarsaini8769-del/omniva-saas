# Omniva Backend Environment Configuration Example
PORT=5001
NODE_ENV=production
CLIENT_URL=https://your-app-domain.example
# Set true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/omniva_saas?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Required to create the first Super Admin. Generate with: openssl rand -hex 32
MASTER_SETUP_KEY=replace_with_a_random_64_character_master_setup_key

# Razorpay webhook signature secret (from the Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

TOKEN_ENCRYPTION_KEY=replace_with_a_random_32_character_token_encryption_key

META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=https://your-app-domain.example/api/meta/oauth/callback
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_meta_webhook_verify_token
META_ACCESS_TOKEN=your_meta_system_user_capi_token_optional
